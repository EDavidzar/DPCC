<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ccpd.es</groupId>
        <artifactId>CCPD8-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>P8DBase</artifactId>
    <packaging>nbm</packaging>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.netbeans.utilities</groupId>
                <artifactId>nbm-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <publicPackages>
                        <publicPackage>ccpd.es.ccpddbcontrollers</publicPackage>
                        <publicPackage>ccpd.es.ccpddbcontrollers.exceptions</publicPackage>
                        <publicPackage>ccpd.es.ccpdlists</publicPackage>
                        <publicPackage>ccpd.es.ccpdregisters</publicPackage>
                        <publicPackage>ccpd.es.ccpdsecuritymeasures</publicPackage>
                        <publicPackage>ccpd.es.ccpdthreatactivity</publicPackage>
                        <publicPackage>ccpd.es.ccpdthreatrisks</publicPackage>
                        <publicPackage>ccpd.es.enterprises</publicPackage>
                        <publicPackage>ccpd.es.p8dbase</publicPackage>
                        <publicPackage>ccpd.es.persistence.clients</publicPackage>
                        <publicPackage>ccpd.es.persistence.compliancerecords</publicPackage>
                        <publicPackage>ccpd.persistence.authentiicate</publicPackage>
                    </publicPackages>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>org.netbeans.api</groupId>
            <artifactId>org-netbeans-api-annotations-common</artifactId>
            <version>${netbeans.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.persistence</groupId>
            <artifactId>jakarta.persistence</artifactId>
            <version>2.2.3</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.netbeans.api</groupId>
            <artifactId>org-openide-util</artifactId>
            <version>RELEASE200</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>ccpd.es</groupId>
            <artifactId>P8Utils</artifactId>
            <version>1.0-SNAPSHOT</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>ccpd.es</groupId>
            <artifactId>P8Classes</artifactId>
            <version>1.0-SNAPSHOT</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.3.0</version>
        </dependency>
    </dependencies>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>